# ---- MongoDB ----
# Local development:
MONGODB_URI=mongodb://127.0.0.1:27017/agrigrid
# Production (MongoDB Atlas) example:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/agrigrid?retryWrites=true&w=majority

# ---- Admin panel ----
# Password used to log in at /admin — CHANGE THIS IN PRODUCTION
ADMIN_PASSWORD=admin123
# Random secret used to sign admin session cookies
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# ---- Site ----
# Public URL of the deployed site (used for SEO / sitemap / canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Telegram (image hosting for admin uploads) ----
# Product photos uploaded in the admin panel are sent to your Telegram bot
# and served back to the site, so no writable disk is needed on the host.
# Get the token from @BotFather, the chat id by messaging the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Email (Gmail SMTP) ----
# When a visitor submits the contact / distributor / product form, the business
# owner gets a notification email and the visitor gets an auto-reply.
# Requires a GOOGLE APP PASSWORD, not the account password:
#   1. Turn on 2-Step Verification at Google Account -> Security
#   2. Create an app password for "Mail"r
# Spaces in the password are stripped at runtime, so paste it as-is.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-character-app-password
# Where enquiry notifications are delivered (defaults to SMTP_USER).
SMTP_NOTIFY_TO=you@gmail.com
