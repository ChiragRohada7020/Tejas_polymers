    "i18n:fix-brand": "tsx scripts/fix-brand-content.ts"
  },
  "dependencies": {
    "mongoose": "^8.16.0",
    "next": "^15.4.5",
    "nodemailer": "^10.0.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.15.0",
