{
  "name": "krusheebindoo-website",
  "version": "1.0.0",
  "private": true,
  "description": "Krusheebindoo by Tejas Polymers - drip irrigation product manufacturer website",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:reveal && next build",
    "start": "next start",
    "seed": "tsx scripts/seed.ts",
    "check:reveal": "tsx scripts/check-reveal.ts",
    "check:responsive": "tsx scripts/check-responsive.cts",
    "check:mobile": "node scripts/check-mobile-overflow.cjs",
    "check:contrast": "node scripts/check-contrast.cjs",
    "check:contrast-pixels": "node scripts/check-contrast-pixels.cjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "brand:logo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-logo.ps1",
    "images:inspect": "tsx scripts/inspect-product-images.cts",
    "images:crop": "tsx scripts/crop-collage.cts",
    "images:repoint": "tsx scripts/repoint-product-images.cts",
    "i18n:migrate": "tsx scripts/migrate-i18n.ts",
    "i18n:seed": "tsx scripts/seed-i18n-content.ts",
